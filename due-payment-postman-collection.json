{
	"info": {
		"_postman_id": "due-payment-api-collection",
		"name": "Due Payment API - Style Unit Backend",
		"description": "Complete collection for testing Due Payment APIs with authentication and example data",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000/api/v1",
			"type": "string"
		},
		{
			"key": "jwt_token",
			"value": "your-admin-jwt-token-here",
			"type": "string"
		},
		{
			"key": "business_owner_id",
			"value": "456e7890-e12b-34c5-d678-901234567890",
			"type": "string"
		},
		{
			"key": "due_payment_id",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "📊 Due Payments Management",
			"item": [
				{
					"name": "1. Get All Due Payments",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has success property\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success', true);",
									"});",
									"",
									"pm.test(\"Response has due payments array\", function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('duePayments');",
									"    pm.expect(jsonData.data.duePayments).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/admin/due-payments?page=1&limit=10",
							"host": ["{{base_url}}"],
							"path": ["admin", "due-payments"],
							"query": [
								{
									"key": "page",
									"value": "1",
									"description": "Page number for pagination"
								},
								{
									"key": "limit",
									"value": "10",
									"description": "Number of items per page"
								}
							]
						},
						"description": "Get all due payments with pagination"
					},
					"response": []
				},
				{
