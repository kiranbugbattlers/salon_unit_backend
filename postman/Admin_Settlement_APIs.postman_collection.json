{
    "info": {
        "name": "Admin Settlement APIs",
        "description": "Settlement APIs for Admin Panel - Daily settlements with 8% commission + 18% GST",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api/v1",
            "type": "string"
        },
        {
            "key": "adminToken",
            "value": "YOUR_ADMIN_JWT_TOKEN_HERE",
            "type": "string"
        }
    ],
    "item": [
        {
            "name": "0. Admin Login (Get Token First)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "if (jsonData.data && jsonData.data.accessToken) {",
                            "    pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
                            "    console.log('Admin token saved successfully!');",
                            "}"
                        ],
                        "type": "text/javascript"
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/auth/admin/login",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "auth",
                        "admin",
                        "login"
                    ]
                },
                "description": "Login as admin to get JWT token. Token will be auto-saved to collection variables."
            },
            "response": []
        },
        {
            "name": "1. Get All Daily Settlements",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/settlements?page=1&limit=50",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "settlements"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1",
                            "description": "Page number"
                        },
                        {
                            "key": "limit",
                            "value": "50",
                            "description": "Items per page"
                        },
                        {
                            "key": "date",
                            "value": "2026-01-07",
                            "description": "Filter by specific date (YYYY-MM-DD)",
                            "disabled": true
                        },
                        {
                            "key": "startDate",
                            "value": "2026-01-01",
                            "description": "Start date for range filter",
                            "disabled": true
                        },
                        {
                            "key": "endDate",
                            "value": "2026-01-08",
                            "description": "End date for range filter",
                            "disabled": true
                        },
                        {
                            "key": "businessOwnerId",
                            "value": "",
                            "description": "Filter by business owner UUID",
                            "disabled": true
                        },
                        {
                            "key": "paidStatus",
                            "value": "pending",
                            "description": "pending | processing | paid | failed",
                            "disabled": true
                        }
                    ]
                },
                "description": "Get all daily settlements with optional filters. Returns vendor details, transaction stats, commission (8%), GST (18%), and settlement amount."
            },
            "response": []
        },
        {
            "name": "1b. Get All History (All Dates)",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/settlements/history?page=1&limit=50",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "settlements",
                        "history"
                    ],
                    "query": [
                        {
                            "key": "page",
                            "value": "1",
                            "description": "Page number"
                        },
                        {
                            "key": "limit",
                            "value": "50",
                            "description": "Items per page"
                        },
                        {
                            "key": "startDate",
                            "value": "2026-01-01",
                            "description": "Filter start date (YYYY-MM-DD)",
                            "disabled": true
                        },
                        {
                            "key": "endDate",
                            "value": "2026-01-08",
                            "description": "Filter end date (YYYY-MM-DD)",
                            "disabled": true
                        },
                        {
                            "key": "businessOwnerId",
                            "value": "",
                            "description": "Filter by business owner UUID",
                            "disabled": true
                        }
                    ]
                },
                "description": "Get ALL settlement history across all dates. Use startDate/endDate for weekly/monthly filtering on UI.\\n\\nReturns per-booking data:\\n- Date, Customer, Amount, Payment Method\\n- Commission, GST, Deduction, Settlement\\n\\nEnable startDate/endDate filters as needed."
            },
            "response": []
        },
        {
            "name": "2. Update Settlement Status",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"businessOwnerId\": \"a3570c45-33f0-4745-99d9-7c7edf9c4ea0\",\n  \"date\": \"2026-01-07\",\n  \"status\": \"paid\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/admin/settlements/update-status",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "settlements",
                        "update-status"
                    ]
                },
                "description": "Update the payment status of a business settlement.\\n\\nRequired fields:\\n- businessOwnerId: UUID from GET settlements response\\n- date: YYYY-MM-DD format\\n- status: pending | processing | paid | failed\\n\\nOptional fields:\\n- transactionReference: Transaction ID\\n- adminNotes: Notes for admin"
            },
            "response": []
        },
        {
            "name": "3. Get Settlement Details",
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    }
                ],
                "url": {
                    "raw": "{{baseUrl}}/admin/settlements/details?businessOwnerId=a3570c45-33f0-4745-99d9-7c7edf9c4ea0&date=2026-01-07",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "settlements",
                        "details"
                    ],
                    "query": [
                        {
                            "key": "businessOwnerId",
                            "value": "a3570c45-33f0-4745-99d9-7c7edf9c4ea0",
                            "description": "Business Owner ID from GET settlements"
                        },
                        {
                            "key": "date",
                            "value": "2026-01-07",
                            "description": "Date for settlement details"
                        }
                    ]
                },
                "description": "Get detailed settlement info for a business owner on a specific date.\\n\\nReturns:\\n- Owner details (name, email, phone)\\n- Business details (salon name, address)\\n- Transaction history (customer name, services, amount, payment method)\\n- Settlement calculation (commission, GST, deduction, final amount)"
            },
            "response": []
        },
        {
            "name": "3. Generate Daily Settlements",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{adminToken}}",
                        "type": "text"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json",
                        "type": "text"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"date\": \"2026-01-07\"\n}"
                },
                "url": {
                    "raw": "{{baseUrl}}/admin/settlements/generate",
                    "host": [
                        "{{baseUrl}}"
                    ],
                    "path": [
                        "admin",
                        "settlements",
                        "generate"
                    ]
                },
                "description": "Generate daily settlements for all approved vendors for a specific date.\n\nThis calculates settlements from completed bookings on that date.\n\nCommission: 8% of total transaction amount\nGST: 18% of commission\nSettlement = Total - (Commission + GST)"
            },
            "response": []
        }
    ]
}