# Application
PORT=3000
NODE_ENV=development

# Database Configuration
# Set DB_MODE to 'local' or 'supabase'
DB_MODE=local

# Local PostgreSQL Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=salon_backend

# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_DB_HOST=your_supabase_db_host
SUPABASE_DB_PORT=5432
SUPABASE_DB_USERNAME=your_supabase_db_username
SUPABASE_DB_PASSWORD=your_supabase_db_password
SUPABASE_DB_NAME=your_supabase_db_name

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Twilio (for OTP)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number
TWILIO_VERIFY_SERVICE_ID=your-twilio-verify-service-id

# BhashSMS (for OTP)
BHASHSMS_API_URL=http://bhashsms.com/api/sendmsg.php
BHASHSMS_USERNAME=your-bhashsms-username
BHASHSMS_PASSWORD=your-bhashsms-password
BHASHSMS_SENDER_ID=SALON

# OTP Provider ('twilio', 'bhashsms', or 'console')
OTP_PROVIDER=console

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_CLEANUP_OLD_RECORDS_MINUTES=60

# Firebase Service Account Path
FIREBASE_SERVICE_ACCOUNT_PATH=/Users/sanskar/Developer/salon-backend/style-plus-project-firebase-adminsdk-fbsvc-0272b1d083.json

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Razorpay Payout Configuration (for settlement payouts to business owners)
RAZORPAY_ACCOUNT_NUMBER=your_razorpay_x_account_number
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Bank Account Encryption Key (for encrypting sensitive banking data)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_32_byte_encryption_key_here